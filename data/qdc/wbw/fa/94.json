  "words": {
    "94:1:1": "آیا نه",
    "94:1:2": "گشایش دادیم",
    "94:1:3": "برای تو",
    "94:1:4": "سینه ات",
    "94:1:5": "1",
    "94:2:1": "و برداشتیم",
    "94:2:2": "از تو",
    "94:2:3": "بار سنگینت",
    "94:2:4": "2",
    "94:3:1": "کسی که",
    "94:3:2": "شکست",
    "94:3:3": "پشت تو را",
    "94:3:4": "3",
    "94:4:1": "و برافراشتیم",
    "94:4:2": "برای تو",
    "94:4:3": "آوازه ات",
    "94:4:4": "4",
    "94:5:1": "پس همانا",
    "94:5:2": "همراه",
    "94:5:3": "دشواری",
    "94:5:4": "آسانی،آسایش",
    "94:5:5": "5",
    "94:6:1": "همانا",
    "94:6:2": "همراه",
    "94:6:3": "دشواری",
    "94:6:4": "آسانی، آسایش",
    "94:6:5": "6",
    "94:7:1": "پس هنگامی که",
    "94:7:2": "فراغت یافتی، بیکار ماندی",
    "94:7:3": "به رنج تن بده",
    "94:7:4": "7",
    "94:8:1": "و به سوی",
    "94:8:2": "پروردگار تو",
    "94:8:3": "رغبت کن",
    "94:8:4": "8"
  }
