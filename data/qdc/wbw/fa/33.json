    "33:72:17": "بسیار ستمگر",
    "33:72:18": "بسیار نادان",
    "33:72:19": "72",
    "33:73:1": "تا عذاب کند",
    "33:73:2": "خداوند",
    "33:73:3": "مردان منافق",
