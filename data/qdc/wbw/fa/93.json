  "words": {
    "93:1:1": "سوگند به روز روشن",
    "93:1:2": "1",
    "93:2:1": "و سوگند به شب",
    "93:2:2": "هنگامی که",
    "93:2:3": "ساکن و آرام شد، تاریکی همه جا را گرفت",
    "93:2:4": "2",
    "93:3:1": "ما نافیه",
    "93:3:2": "رها کرد تو را",
    "93:3:3": "پروردگار تو",
    "93:3:4": "و دشمنی کرد، و خشم گرفت",
    "93:3:5": "و دشمنی کرد، و خشم گرفت",
    "93:3:6": "3",
    "93:4:1": "و البته آخرت",
    "93:4:2": "بهتر",
    "93:4:3": "برای تو",
    "93:4:4": "از",
    "93:4:5": "اول کار، دنیا",
    "93:4:6": "4",
    "93:5:1": "و قطعاً به زودی",
    "93:5:2": "عطایت خواهد کرد",
    "93:5:3": "پروردگار تو",
    "93:5:4": "پس خشنود می شوی",
    "93:5:5": "5",
    "93:6:1": "آیا نه",
    "93:6:2": "یافت تو را",
    "93:6:3": "یتیمی",
    "93:6:4": "پس پناه داد",
    "93:6:5": "6",
    "93:7:1": "و یافت تو را",
    "93:7:2": "سرگشته",
    "93:7:3": "پس هدایت کرد",
    "93:7:4": "7",
    "93:8:1": "و یافت تو را",
    "93:8:2": "فقیر، بی چیز",
    "93:8:3": "پس بی نیاز کرد",
    "93:8:4": "8",
    "93:9:1": "پس امّا",
    "93:9:2": "یتیم",
    "93:9:3": "پس خوار و ذلیل نکن",
    "93:9:4": "پس خوار و ذلیل نکن",
    "93:9:5": "9",
    "93:10:1": "و امّا",
    "93:10:2": "سائل",
    "93:10:3": "پس طرد نکن",
    "93:10:4": "پس طرد نکن",
    "93:10:5": "10",
    "93:11:1": "و امّا",
    "93:11:2": "موهبت",
    "93:11:3": "پروردگار تو",
    "93:11:4": "پس باز گو",
    "93:11:5": "11"
  }
}