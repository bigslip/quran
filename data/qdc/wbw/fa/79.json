  "words": {
    "79:1:1": "سوگند به بیرون کشندگان",
    "79:1:2": "اغراق آمیز، سخت کشیدن",
    "79:1:3": "1",
    "79:2:1": "و ستانندگان جان به آرامی و مدارا",
    "79:2:2": "آرام کشیدن",
    "79:2:3": "2",
    "79:3:1": "و به سرعت روندگان",
    "79:3:2": "حرکت سریع",
    "79:3:3": "3",
    "79:4:1": "پس سبقت گیرندگان",
    "79:4:2": "پیشی گرفتن",
    "79:4:3": "4",
    "79:5:1": "پس تدبیرکنندگان",
    "79:5:2": "فرمانی",
    "79:5:3": "5",
    "79:6:1": "روز",
    "79:6:2": "می لرزد",
    "79:6:3": "لرزنده",
    "79:6:4": "6",
    "79:7:1": "به دنبال آن می آید",
    "79:7:2": "به دنبال آینده",
    "79:7:3": "7",
    "79:8:1": "قلبها",
    "79:8:2": "آن روز",
    "79:8:3": "مضطرب، نگران",
    "79:8:4": "8",
    "79:9:1": "دیدگان آن",
    "79:9:2": "وارفته و فرو شکسته",
    "79:9:3": "9",
    "79:10:1": "می‌گویند",
    "79:10:2": "آیا براستی ما",
    "79:10:3": "بازگردانده شدگان",
    "79:10:4": "در",
    "79:10:5": "جای اول، حالت قبل",
    "79:10:6": "10",
    "79:11:1": "آیا وقتی که",
    "79:11:2": "بودیم",
    "79:11:3": "استخوانها",
    "79:11:4": "پوسیده، متلاشی شده",
    "79:11:5": "11",
    "79:12:1": "گفتند",
    "79:12:2": "آن",
    "79:12:3": "در این صورت",
    "79:12:4": "بازگشت",
    "79:12:5": "زیانبار",
    "79:12:6": "12",
    "79:13:1": "پس جز این نیست که",
    "79:13:2": "آن",
    "79:13:3": "یک صیحه",
    "79:13:4": "یک صیحه",
    "79:13:5": "13",
    "79:14:1": "پس به ناگاه",
    "79:14:2": "ایشان",
