    "79:14:4": "14",
    "79:15:1": "آیا",
    "79:15:2": "آمد برای تو",
    "79:15:3": "حکایت",
    "79:15:4": "موسی",
    "79:15:5": "15",
    "79:16:1": "هنگامی که",
    "79:16:2": "ندا داد او را",
    "79:16:3": "پروردگارش",
    "79:16:4": "در وادی",
    "79:16:5": "مقدس",
    "79:16:6": "طوی",
    "79:16:7": "16",
    "79:17:1": "برو",
    "79:17:2": "به سوی",
    "79:17:3": "فرعون",
    "79:17:4": "همانا او",
    "79:17:5": "سرکشی کرد",
    "79:17:6": "17",
    "79:18:1": "پس بگو",
