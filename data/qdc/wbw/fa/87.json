  "words": {
    "87:1:1": "تسبیح کن",
    "87:1:2": "نام",
    "87:1:3": "پروردگار والایت",
    "87:1:4": "پروردگار والایت",
    "87:1:5": "1",
    "87:2:1": "کسی که",
    "87:2:2": "آفرید",
    "87:2:3": "پس آراست، پس هماهنگ و متناسب کرد",
    "87:2:4": "2",
    "87:3:1": "و آنکه",
    "87:3:2": "طرح ریزی کرد، نقشه کشید",
    "87:3:3": "پس هدایت کرد",
    "87:3:4": "3",
    "87:4:1": "و آنکه",
    "87:4:2": "رویانید",
    "87:4:3": "چراگاه، چمنزار",
    "87:4:4": "4",
    "87:5:1": "پس قرار داد او را",
    "87:5:2": "گیاهان خشکیده",
    "87:5:3": "سیاه تیره",
    "87:5:4": "5",
    "87:6:1": "به زودی خواهیم خواند",
    "87:6:2": "پس فراموش نمی کنی",
    "87:6:3": "پس فراموش نمی کنی",
    "87:6:4": "6",
    "87:7:1": "مگر",
    "87:7:2": "آن چه",
    "87:7:3": "خواست",
    "87:7:4": "خداوند",
    "87:7:5": "همانا او",
    "87:7:6": "می‌داند",
    "87:7:7": "آشکار",
    "87:7:8": "و آن چه",
    "87:7:9": "پنهان می شود",
    "87:7:10": "7",
    "87:8:1": "و آسان می گردانیم برای تو",
    "87:8:2": "برای آسانترین راه",
    "87:8:3": "8",
    "87:9:1": "پس به یاد بیاور، پس پند ده",
    "87:9:2": "اگر",
    "87:9:3": "سود دهد",
    "87:9:4": "متذکر شدن",
    "87:9:5": "9",
    "87:10:1": "پند خواهد گرفت",
    "87:10:2": "کسی که",
    "87:10:3": "می ترسد",
    "87:10:4": "10",
    "87:11:1": "و اجتناب می کند از او",
    "87:11:2": "شقی ترین",
    "87:11:3": "11",
    "87:12:1": "کسی که",
    "87:12:2": "وارد آتش می شود، به آتش می سوزد",
    "87:12:3": "آتشی",
    "87:12:4": "بزرگ، فراگیر",
    "87:12:5": "12",
    "87:13:1": "سپس",
    "87:13:2": "نه",
    "87:13:3": "می میرد",
    "87:13:4": "در آن جا",
    "87:13:5": "و نه",
    "87:13:6": "زنده می شود",
    "87:13:7": "13",
    "87:14:1": "البته",
    "87:14:2": "رستگار و پیروز شد",
    "87:14:3": "کسی که",
    "87:14:4": "خود را پاک داشت",
    "87:14:5": "14",
    "87:15:1": "و یاد کرد",
    "87:15:2": "نام",
    "87:15:3": "پروردگارش",
    "87:15:4": "پس نماز خواند، پس نماز گزارد",
    "87:15:5": "15",
    "87:16:1": "بلکه",
    "87:16:2": "ترجیح می دهید",
    "87:16:3": "زندگی",
    "87:16:4": "دنیا",
    "87:16:5": "16",
    "87:17:1": "و آخرت",
    "87:17:2": "بهتر",
    "87:17:3": "و ماندگار تر",
    "87:17:4": "17",
    "87:18:1": "همانا",
    "87:18:2": "این",
    "87:18:3": "قطعاً در",
    "87:18:4": "کتابها",
    "87:18:5": "پیشین",
    "87:18:6": "18",
    "87:19:1": "کتاب ها",
    "87:19:2": "ابراهیم",
    "87:19:3": "و موسی",
    "87:19:4": "19"
  }
