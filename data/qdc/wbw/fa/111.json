  "words": {
    "111:1:1": "نابود باد، بریده باد",
    "111:1:2": "دو دست",
    "111:1:3": "ابو لهب",
    "111:1:4": "ابو لهب",
    "111:1:5": "و نابود باد",
    "111:1:6": "1",
    "111:2:1": "نه",
    "111:2:2": "بی نیاز کرد",
    "111:2:3": "از او",
    "111:2:4": "مالش",
    "111:2:5": "و آن چه",
    "111:2:6": "به دست آورد",
    "111:2:7": "2",
    "111:3:1": "به زودی وارد آتش خواهد شد",
    "111:3:2": "آتشی",
    "111:3:3": "دارای",
    "111:3:4": "شعله و زبانه",
    "111:3:5": "3",
    "111:4:1": "و همسر او",
    "111:4:2": "حمل کننده، بارکش",
    "111:4:3": "هیزم",
    "111:4:4": "4",
    "111:5:1": "در",
    "111:5:2": "گردن او",
    "111:5:3": "طناب، ریسمان",
    "111:5:4": "از",
    "111:5:5": "لیف خرما",
    "111:5:6": "5"
  }
