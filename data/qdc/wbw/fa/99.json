  "words": {
    "99:1:1": "هنگامی که",
    "99:1:2": "لرزانده شد",
    "99:1:3": "زمین",
    "99:1:4": "زلزله مخصوص خودش را",
    "99:1:5": "1",
    "99:2:1": "و بیرون آورد",
    "99:2:2": "زمین",
    "99:2:3": "بارهای سنگینش را",
    "99:2:4": "2",
    "99:3:1": "و گفت",
    "99:3:2": "انسان",
    "99:3:3": "چیست",
    "99:3:4": "برای آن‌",
    "99:3:5": "3",
    "99:4:1": "آن روز",
    "99:4:2": "بازگو می کند",
    "99:4:3": "خبرهایش را",
    "99:4:4": "4",
    "99:5:1": "به دلیل آن است که",
    "99:5:2": "پروردگارت",
    "99:5:3": "اشاره کرد، پیام داد",
    "99:5:4": "به آن",
    "99:5:5": "5",
    "99:6:1": "آن روز",
    "99:6:2": "بیرون می آید، بر می گردد",
    "99:6:3": "مردم",
    "99:6:4": "دسته دسته",
    "99:6:5": "تا نشان داده شود به آنها",
    "99:6:6": "کردارشان",
    "99:6:7": "6",
    "99:7:1": "پس هر کس",
    "99:7:2": "انجام دهد",
    "99:7:3": "هم وزن",
    "99:7:4": "ذرّه ای",
    "99:7:5": "کار نیک",
    "99:7:6": "می بیند آن را",
    "99:7:7": "7",
    "99:8:1": "و هر کس",
    "99:8:2": "انجام دهد",
    "99:8:3": "هم وزن",
    "99:8:4": "ذرّه ای",
    "99:8:5": "شر",
    "99:8:6": "می بیند آن را",
    "99:8:7": "8"
  }
