  "words": {
    "92:1:1": "و سوگند به شب",
    "92:1:2": "هنگامی که",
    "92:1:3": "فرا گرفت",
    "92:1:4": "1",
    "92:2:1": "و روز",
    "92:2:2": "هنگامی که",
    "92:2:3": "جلوه کرد",
    "92:2:4": "2",
    "92:3:1": "و آن چه",
    "92:3:2": "آفرید",
    "92:3:3": "مذکر، نر",
    "92:3:4": "و زن",
    "92:3:5": "3",
    "92:4:1": "همانا",
    "92:4:2": "تلاش شما",
    "92:4:3": "پراکنده ها",
    "92:4:4": "4",
    "92:5:1": "پس امّا",
    "92:5:2": "کسی که",
    "92:5:3": "عطا کرد",
    "92:5:4": "و پرهیزکاری کند",
    "92:5:5": "5",
    "92:6:1": "و تصدیق کرد",
    "92:6:2": "به نیکوترین",
    "92:6:3": "6",
    "92:7:1": "پس سهل و آسان خواهیم کرد برای او، پس آماده خواهیم کرد برای او",
    "92:7:2": "آسانترین",
    "92:7:3": "7",
    "92:8:1": "و امّا",
    "92:8:2": "کسی که",
    "92:8:3": "بخل ورزید",
    "92:8:4": "و اظهار بی نیازی کرد",
    "92:8:5": "8",
    "92:9:1": "و تکذیب کرد",
    "92:9:2": "نیکوترین را",
    "92:9:3": "9",
    "92:10:1": "پس سهل و آسان خواهیم کرد برای او، پس آماده خواهیم کرد برای او",
    "92:10:2": "دشوارترین",
    "92:10:3": "10",
    "92:11:1": "بی نیاز نمی کند",
    "92:11:2": "بی نیاز نمی کند",
    "92:11:3": "از آن",
    "92:11:4": "مالش",
    "92:11:5": "هنگامی که",
    "92:11:6": "به هلاکت افتاد",
    "92:11:7": "11",
    "92:12:1": "همانا",
    "92:12:2": "بر ما",
    "92:12:3": "هدایت",
    "92:12:4": "12",
    "92:13:1": "و همانا",
    "92:13:2": "برای ما",
    "92:13:3": "آن جهان",
    "92:13:4": "و این جهان",
    "92:13:5": "13",
    "92:14:1": "پس بیم دادم شما را",
    "92:14:2": "آتشی",
    "92:14:3": "زبانه می کشد",
    "92:14:4": "14",
    "92:15:1": "نه",
    "92:15:2": "وارد آن(آتش) می شود",
    "92:15:3": "مگر",
    "92:15:4": "شقی ترین",
    "92:15:5": "15",
    "92:16:1": "کسی که",
    "92:16:2": "تکذیب کرد",
    "92:16:3": "و رو بگردانید",
    "92:16:4": "16",
    "92:17:1": "و دور داشته خواهد شد",
    "92:17:2": "پرهیزکار ترین",
    "92:17:3": "17",
    "92:18:1": "کسی که",
    "92:18:2": "می‌دهد",
    "92:18:3": "مالش",
    "92:18:4": "پاک می گردد",
    "92:18:5": "18",
    "92:19:1": "و نیست",
    "92:19:2": "برای احدی",
    "92:19:3": "نزد او",
    "92:19:4": "از",
    "92:19:5": "نعمت",
    "92:19:6": "جزا داده می شود",
    "92:19:7": "19",
    "92:20:1": "مگر",
    "92:20:2": "(جهت) طلب کردن",
    "92:20:3": "رضایت",
    "92:20:4": "پروردگار والایش",
    "92:20:5": "پروردگار والایش",
    "92:20:6": "20",
    "92:21:1": "و قطعاً به زودی",
    "92:21:2": "خشنود گردد",
    "92:21:3": "21"
  }
}