  "words": {
    "104:1:1": "هلاک و بدبختی",
    "104:1:2": "برای هر",
    "104:1:3": "بسیار عیبجو",
    "104:1:4": "بسیار طعنه زننده",
    "104:1:5": "1",
    "104:2:1": "کسی که",
    "104:2:2": "جمع کرد",
    "104:2:3": "مال",
    "104:2:4": "و حساب کرد آن را",
    "104:2:5": "2",
    "104:3:1": "می پندارد",
    "104:3:2": "که",
    "104:3:3": "مالش",
    "104:3:4": "جاودانه کرد او را",
    "104:3:5": "3",
    "104:4:1": "چنین نیست",
    "104:4:2": "البته حتماً دور انداخته می شود",
    "104:4:3": "در",
    "104:4:4": "در هم شکننده، خردکننده، نامی از نامهای دوزخ",
    "104:4:5": "4",
    "104:5:1": "و چه چیز",
    "104:5:2": "آگاه کرد تو را",
    "104:5:3": "چیست",
    "104:5:4": "در هم شکننده، خردکننده، نامی از نامهای دوزخ",
    "104:5:5": "5",
    "104:6:1": "آتش",
    "104:6:2": "خداوند",
    "104:6:3": "افروخته شده، فروزان",
    "104:6:4": "6",
    "104:7:1": "که",
    "104:7:2": "زبانه می کشد، چیره می شود",
    "104:7:3": "بر",
    "104:7:4": "دل ها",
    "104:7:5": "7",
    "104:8:1": "همانا آن",
    "104:8:2": "بر آنها",
    "104:8:3": "سرپوشیده",
    "104:8:4": "8",
    "104:9:1": "در",
    "104:9:2": "ستونها",
    "104:9:3": "طویل و کشیده شده",
    "104:9:4": "9"
  }
}