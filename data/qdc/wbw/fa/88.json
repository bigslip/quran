    "88:3:1": "تلاشگر، عامل",
    "88:3:2": "رنج کشیده، رنج دهنده",
    "88:3:3": "3",
    "88:4:1": "به آتش می سوزد",
    "88:4:2": "آتشی",
    "88:4:3": "سوزنده، سوزان",
    "88:4:4": "4",
    "88:5:1": "نوشانده می شود",
