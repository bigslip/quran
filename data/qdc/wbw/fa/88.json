    "88:5:5": "5",
    "88:6:1": "نیست",
    "88:6:2": "برای آنان",
    "88:6:3": "غذایی",
    "88:6:4": "مگر",
    "88:6:5": "از",
    "88:6:6": "طعامی از خار سمّی",
    "88:6:7": "6",
    "88:7:1": "نه",
    "88:7:2": "فربه می کند",
    "88:7:3": "و نه",
    "88:7:4": "بی نیاز می کند",
    "88:7:5": "از",
    "88:7:6": "گرسنگی",
    "88:7:7": "7",
    "88:8:1": "چهره‌هایی",
    "88:8:2": "آن روز",
    "88:8:3": "متنعم، برخوردار و شاداب",
    "88:8:4": "8",
    "88:9:1": "از سعی خود",
    "88:9:2": "راضی",
    "88:9:3": "9",
    "88:10:1": "در",
    "88:10:2": "باغ",
    "88:10:3": "برین",
    "88:10:4": "10",
    "88:11:1": "نه",
    "88:11:2": "می شنوی",
    "88:11:3": "در آن جا",
    "88:11:4": "بیهوده، یاوه",
    "88:11:5": "11",
