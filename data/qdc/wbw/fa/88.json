    "88:12:2": "چشمه ای",
    "88:12:3": "روان",
    "88:12:4": "12",
    "88:13:1": "در آن جا",
    "88:13:2": "تخت ها",
    "88:13:3": "بلند",
    "88:13:4": "13",
    "88:14:1": "و قدح ها",
    "88:14:2": "نهاده شده(در کنار چشمه سار)",
    "88:14:3": "14",
    "88:15:1": "و پشتی ها",
    "88:15:2": "به ردیف چیده شده",
    "88:15:3": "15",
    "88:16:1": "و فرشهای نفیس",
    "88:16:2": "پهن شده",
    "88:16:3": "16",
    "88:17:1": "آیا پس نظر نمی کنند",
    "88:17:2": "آیا پس نظر نمی کنند",
    "88:17:3": "به سوی",
    "88:17:4": "شتر",
    "88:17:5": "چگونه",
    "88:17:6": "آفریده شده",
    "88:17:7": "17",
    "88:18:1": "و به سوی",
    "88:18:2": "آسمان",
    "88:18:3": "چگونه",
    "88:18:4": "برافراشته شده",
    "88:18:5": "18",
    "88:19:1": "و به سوی",
    "88:19:2": "کوهها",
    "88:19:3": "چگونه",
    "88:19:4": "نصب شده، استوار گشته",
    "88:19:5": "19",
    "88:20:1": "و به سوی",
    "88:20:2": "زمین",
    "88:20:3": "چگونه",
    "88:20:4": "هموار شده",
    "88:20:5": "20",
