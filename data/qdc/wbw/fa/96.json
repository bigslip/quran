    "96:15:3": "نه",
    "96:15:4": "دست برداشت",
    "96:15:5": "قطعاً با خواری و شدت می کشیم",
    "96:15:6": "با موی پیشانی، با قسمت جلوی سر",
    "96:15:7": "15",
    "96:16:1": "موی پیشانی، قسمت جلوی سر",
    "96:16:2": "دروغ پرداز",
    "96:16:3": "خطا کار",
    "96:16:4": "16",
    "96:17:1": "پس فرا بخواند",
