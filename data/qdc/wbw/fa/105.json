  "words": {
    "105:1:1": "آیا ندیدی",
    "105:1:2": "آیا ندیدی",
    "105:1:3": "چگونه",
    "105:1:4": "انجام داد",
    "105:1:5": "پروردگار تو",
    "105:1:6": "با اصحاب",
    "105:1:7": "فیل",
    "105:1:8": "1",
    "105:2:1": "آیا نه",
    "105:2:2": "قرار داد",
    "105:2:3": "نقشه آنها",
    "105:2:4": "در",
    "105:2:5": "سر در گم کردن، بی ثمرز نمودن",
    "105:2:6": "2",
