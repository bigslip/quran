  "chapterId": 91,
  "language": "fa",
  "languageName": "persian",
  "languageId": 43,
  "words": {
    "91:1:1": "سوگند به خورشید",
    "91:1:2": "و تابش آن",
    "91:1:3": "1",
    "91:2:1": "سوگند به ماه",
    "91:2:2": "هنگامی که",
    "91:2:3": "از پی آن آمد",
    "91:2:4": "2",
    "91:3:1": "و سوگند به روز",
    "91:3:2": "هنگامی که",
    "91:3:3": "ظاهر کرد آن را",
    "91:3:4": "3",
    "91:4:1": "و سوگند به شب",
    "91:4:2": "هنگامی که",
    "91:4:3": "می پوشاند آن را",
    "91:4:4": "4",
    "91:5:1": "سوگند به آسمان",
    "91:5:2": "و آن که",
    "91:5:3": "بنا کرد آن را",
    "91:5:4": "5",
    "91:6:1": "و زمین",
    "91:6:2": "و آن که",
    "91:6:3": "گستراند آن را",
    "91:6:4": "6",
    "91:7:1": "و سوگند به نفس",
    "91:7:2": "و آن که",
    "91:7:3": "ساخت و پرداخت آن را",
    "91:7:4": "7",
    "91:8:1": "پس الهام کرد به او",
    "91:8:2": "گناهکاریش",
    "91:8:3": "و حق گراییش",
    "91:8:4": "8",
    "91:9:1": "البته",
    "91:9:2": "رستگار و پیروز شد",
    "91:9:3": "کسی که",
    "91:9:4": "تزکیه کرد خود را",
    "91:9:5": "9",
    "91:10:1": "و بی گمان",
    "91:10:2": "محروم شد، باخت",
    "91:10:3": "کسی که",
    "91:10:4": "آلوده کرد آن را",
    "91:10:5": "10",
    "91:11:1": "تکذیب کرد",
    "91:11:2": "ثمود",
    "91:11:3": "از روی طغیان و سرکشی",
    "91:11:4": "11",
    "91:12:1": "آن زمان که",
    "91:12:2": "فرستاده شد، بر خاست و حرکت کرد",
    "91:12:3": "شقی ترین",
    "91:12:4": "12",
    "91:13:1": "پس گفت",
    "91:13:2": "به آنان",
    "91:13:3": "رسول",
    "91:13:4": "خداوند",
    "91:13:5": "ناقه",
    "91:13:6": "خداوند",
    "91:13:7": "و آب دادن او، نوبت آب او",
    "91:13:8": "13",
    "91:14:1": "پس تکذیب کردند او را",
    "91:14:2": "پس دست و پایش بریدند",
    "91:14:3": "پس هلاک کرد",
    "91:14:4": "آنها را",
    "91:14:5": "پروردگارشان",
    "91:14:6": "به گناهانشان",
    "91:14:7": "پس با خاک یکسان کرد آنها را",
    "91:14:8": "14",
    "91:15:1": "و نه",
    "91:15:2": "می ترسد",
    "91:15:3": "عاقبت آن",
    "91:15:4": "15"
  }
}