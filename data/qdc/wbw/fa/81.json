  "words": {
    "81:1:1": "هنگامی که",
    "81:1:2": "خورشید",
    "81:1:3": "در هم پیچیده شد",
    "81:1:4": "1",
    "81:2:1": "و هنگامی که",
    "81:2:2": "ستارگان",
    "81:2:3": "تیره و تار شد",
    "81:2:4": "2",
    "81:3:1": "و هنگامی که",
    "81:3:2": "کوهها",
    "81:3:3": "حرکت داده شد",
    "81:3:4": "3",
    "81:4:1": "و هنگامی که",
    "81:4:2": "شتران آبستن ده ماهه",
    "81:4:3": "به حال خود رها شد",
    "81:4:4": "4",
    "81:5:1": "و هنگامی که",
    "81:5:2": "درندگان",
    "81:5:3": "یکجا جمع گردانده شد",
    "81:5:4": "5",
    "81:6:1": "و هنگامی که",
    "81:6:2": "دریاها",
    "81:6:3": "افروخته شد",
    "81:6:4": "6",
    "81:7:1": "و هنگامی که",
    "81:7:2": "جان ها",
    "81:7:3": "قرین شد، جفت شد",
    "81:7:4": "7",
    "81:8:1": "و هنگامی که",
    "81:8:2": "دختر زنده به گور شده",
    "81:8:3": "پرسیده شد، بازخواست گردید",
    "81:8:4": "8",
    "81:9:1": "به کدام",
    "81:9:2": "گناه",
    "81:9:3": "کشته شد",
    "81:9:4": "9",
    "81:10:1": "و هنگامی که",
    "81:10:2": "نامه های اعمال",
    "81:10:3": "پخش گردید",
    "81:10:4": "10",
    "81:11:1": "و هنگامی که",
    "81:11:2": "آسمان",
    "81:11:3": "برداشته شد، پرده کنار رفت",
    "81:11:4": "11",
    "81:12:1": "و هنگامی که",
    "81:12:2": "جهنم",
    "81:12:3": "زبانه کشید، مشتعل شد",
    "81:12:4": "12",
    "81:13:1": "و هنگامی که",
    "81:13:2": "بهشت",
    "81:13:3": "نزدیک آورده شد",
    "81:13:4": "13",
    "81:14:1": "دانست",
    "81:14:2": "کسی",
    "81:14:3": "آن چه",
    "81:14:4": "حاضر آورد",
    "81:14:5": "14",
    "81:15:1": "سوگند نمی خورم، نه! سوگند می خورم",
    "81:15:2": "سوگند نمی خورم، نه! سوگند می خورم",
    "81:15:3": "به پنهان شونده ها",
    "81:15:4": "15",
    "81:16:1": "روان شوندگان",
    "81:16:2": "پنهان شوندگان، غروب کنندگان",
    "81:16:3": "16",
    "81:17:1": "و سوگند به شب",
    "81:17:2": "هنگامی که",
    "81:17:3": "پشت کرد و رفت",
    "81:17:4": "17",
    "81:18:1": "و سوگند به بامداد",
    "81:18:2": "هنگامی که",
    "81:18:3": "بر دمید، نفس کشید",
    "81:18:4": "18",
    "81:19:1": "همانا او",
    "81:19:2": "قطعاً گفتار",
    "81:19:3": "پیامبری",
    "81:19:4": "ارجمند، گرانقدر",
    "81:19:5": "19",
    "81:20:1": "صاحب",
    "81:20:2": "نیرو",
    "81:20:3": "نزد",
    "81:20:4": "صاحب",
    "81:20:5": "عرش",
    "81:20:6": "صاحب منزلت، برجسته",
    "81:20:7": "20",
    "81:21:1": "مورد اطاعت",
    "81:21:2": "آنجا",
    "81:21:3": "امین",
    "81:21:4": "21",
    "81:22:1": "و نیست",
    "81:22:2": "رفیق شما",
    "81:22:3": "مجنون",
    "81:22:4": "22",
    "81:23:1": "و بی‌تردید",
    "81:23:2": "دید آن را",
    "81:23:3": "در افق",
    "81:23:4": "روشن",
    "81:23:5": "23",
    "81:24:1": "و نیست",
    "81:24:2": "او",
    "81:24:3": "بر",
    "81:24:4": "نهان",
    "81:24:5": "بخیل و تنگ نظر",
    "81:24:6": "24",
    "81:25:1": "و نیست",
    "81:25:2": "او",
    "81:25:3": "گفتار",
    "81:25:4": "شیطان",
    "81:25:5": "رانده شده",
    "81:25:6": "25",
    "81:26:1": "پس کجا",
    "81:26:2": "می روید",
    "81:26:3": "26",
    "81:27:1": "نیست",
    "81:27:2": "او",
    "81:27:3": "مگر",
    "81:27:4": "تذکاری",
    "81:27:5": "برای جهانیان",
    "81:27:6": "27",
    "81:28:1": "برای هر کس",
    "81:28:2": "خواست",
    "81:28:3": "از شما",
    "81:28:4": "که",
    "81:28:5": "مستقیم شود",
    "81:28:6": "28",
    "81:29:1": "ما نافیه",
    "81:29:2": "می خواهید",
    "81:29:3": "مگر",
    "81:29:4": "اینکه",
    "81:29:5": "می خواهد",
    "81:29:6": "خداوند",
