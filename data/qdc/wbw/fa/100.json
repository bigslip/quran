  "words": {
    "100:1:1": "قسم به اسبان تیز پا",
    "100:1:2": "صدای نفس های اسب در حال دویدن",
    "100:1:3": "1",
    "100:2:1": "و آتش افروزان، و جرقه زنان",
    "100:2:2": "تولید جرقه با سنگ چخماخ",
    "100:2:3": "2",
    "100:3:1": "و به یورش برندگان",
    "100:3:2": "صبح هنگام",
    "100:3:3": "3",
    "100:4:1": "پس زیر و رو کردند، پس پراکندند",
    "100:4:2": "به آن",
    "100:4:3": "گرد و غبار",
    "100:4:4": "4",
    "100:5:1": "پس به وسط لشکر زدند",
    "100:5:2": "به آن",
    "100:5:3": "یکجا",
    "100:5:4": "5",
    "100:6:1": "همانا",
    "100:6:2": "انسان",
    "100:6:3": "در برابر خدایش",
    "100:6:4": "بسیار ناسپاس",
    "100:6:5": "6",
    "100:7:1": "و همانا او",
    "100:7:2": "بر",
    "100:7:3": "آن",
    "100:7:4": "به خوبی گواه است",
    "100:7:5": "7",
    "100:8:1": "و همانا او",
    "100:8:2": "برای دوستی",
    "100:8:3": "دنیا",
    "100:8:4": "بسیار (حریص)",
    "100:8:5": "8",
    "100:9:1": "آیا پس نمی داند",
    "100:9:2": "آیا پس نمی داند",
    "100:9:3": "هنگامی که",
    "100:9:4": "زیر و رو شد",
    "100:9:5": "آن چه",
    "100:9:6": "در",
    "100:9:7": "گورها",
    "100:9:8": "9",
    "100:10:1": "و به دست آورده شد",
    "100:10:2": "آن چه",
    "100:10:3": "در",
    "100:10:4": "سینه‌ها",
    "100:10:5": "10",
    "100:11:1": "همانا",
    "100:11:2": "پروردگارشان",
    "100:11:3": "به آنان",
    "100:11:4": "آن روز",
    "100:11:5": "آگاه",
    "100:11:6": "11"
  }
}