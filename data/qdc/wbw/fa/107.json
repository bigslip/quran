  "words": {
    "107:1:1": "آیا دیدی",
    "107:1:2": "کسی که",
    "107:1:3": "تکذیب کرد",
    "107:1:4": "رستاخیز را",
    "107:1:5": "1",
    "107:2:1": "پس او",
    "107:2:2": "کسی که",
    "107:2:3": "به خشونت میراند",
    "107:2:4": "یتیم",
    "107:2:5": "2",
    "107:3:1": "و نه",
    "107:3:2": "ترغیب می کند، وا می دارد",
    "107:3:3": "بر",
    "107:3:4": "طعام",
    "107:3:5": "مسکین",
    "107:3:6": "3",
    "107:4:1": "پس وای",
    "107:4:2": "بر نماز گزاران",
    "107:4:3": "4",
    "107:5:1": "کسانی که",
    "107:5:2": "ایشان",
    "107:5:3": "از",
    "107:5:4": "نمازهایشان",
    "107:5:5": "غافلان، سهل انگاران",
    "107:5:6": "5",
    "107:6:1": "کسانی که",
    "107:6:2": "ایشان",
    "107:6:3": "ریا می کنند",
    "107:6:4": "6",
    "107:7:1": "و خودداری می کنند",
    "107:7:2": "آنچه مفید باشد از وسایل منزل",
    "107:7:3": "7"
  }
}