{
  "expo": {
    "name": "قرآن کریم | Quran.ir",
    "slug": "quran-ir-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041410"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.quran.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041410"
      },
      "package": "ir.quran.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Vazirmatn-Regular.ttf",
            "./assets/fonts/UthmanicHafs.ttf",
            "./assets/fonts/IndoPakNastaleeq.ttf"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ],
    "scheme": "quranir",
    "experiments": {
      "typedRoutes": true
    }
  }
}
